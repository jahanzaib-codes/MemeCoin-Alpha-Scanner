# ==============================================================================
# MemeCoin-Alpha-Scanner Environment Configuration Template
# ==============================================================================

# Network RPC Endpoints
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# Yellowstone / Helius gRPC Streaming (Optional for sub-5ms latency)
HELIUS_GRPC_ENDPOINT=
HELIUS_API_KEY=

# Scanner Filters
MIN_INITIAL_LIQUIDITY_USD=5000.0
MAX_DEV_WALLET_HOLDING_PCT=0.08  # Max 8% dev holding
MAX_TOP_10_HOLDERS_PCT=0.35      # Max 35% top 10 concentration
MIN_SMART_MONEY_CONFIRMATIONS=1
MAX_ALLOWABLE_TAX_PCT=0.01       # Max 1% buy/sell tax

# FastMCP Server (Optional for Claude & Cursor Integration)
MCP_ENABLED=true
MCP_SERVER_NAME=MemeCoin-Alpha-Scanner
